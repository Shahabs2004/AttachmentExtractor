<Application x:Class="AttachmentExtractor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AttachmentExtractor.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
            <conv:ExtensionToBrushConverter x:Key="ExtensionToBrush" />
            <conv:ImportanceToBrushConverter x:Key="ImportanceToBrush" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
