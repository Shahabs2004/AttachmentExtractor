<Window x:Class="AttachmentExtractor.App.Views.RuleBuilderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AttachmentExtractor.App.ViewModels"
        Title="ویرایشگر فیلتر پیشرفته"
        Width="1000"
        Height="680"
        MinWidth="840"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        FontSize="13">
    <Window.Resources>
        <HierarchicalDataTemplate DataType="{x:Type vm:RuleNodeViewModel}"
                                  ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <Border Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="6"
                        Padding="8,2"
                        MinWidth="44">
                    <TextBlock Text="{Binding NodeBadge}"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding Title}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="300" />
            </StackPanel>
        </HierarchicalDataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" MinWidth="300" />
            <ColumnDefinition Width="8" />
            <ColumnDefinition Width="*" MinWidth="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource Card}" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ساختار فیلتر" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{Binding Summary}"
                                   Style="{StaticResource Caption}"
                                   Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="پاک کردن"
                            Style="{StaticResource SmallSecondaryButton}"
                            Command="{Binding ClearCommand}"
                            VerticalAlignment="Top" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,12,0,8">
                    <TextBlock Text="ترکیب شروط سطح اول" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Root.GroupOperators}"
                              DisplayMemberPath="Label"
                              SelectedItem="{Binding Root.SelectedGroupOperator, Mode=TwoWay}"
                              Style="{StaticResource ModernComboBox}" />
                </StackPanel>

                <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                    <Button Content="افزودن شرط"
                            Style="{StaticResource SmallPrimaryButton}"
                            Command="{Binding AddConditionCommand}"
                            Margin="0,0,6,6" />
                    <Button Content="افزودن گروه"
                            Style="{StaticResource SmallSecondaryButton}"
                            Command="{Binding AddGroupCommand}"
                            Margin="0,0,6,6" />
                    <Button Content="حذف"
                            Style="{StaticResource SmallSecondaryButton}"
                            Command="{Binding RemoveCommand}"
                            Margin="0,0,6,6" />
                    <Button Content="بالا"
                            Style="{StaticResource SmallSecondaryButton}"
                            Command="{Binding MoveUpCommand}"
                            Margin="0,0,6,6" />
                    <Button Content="پایین"
                            Style="{StaticResource SmallSecondaryButton}"
                            Command="{Binding MoveDownCommand}"
                            Margin="0,0,6,6" />
                </WrapPanel>

                <Grid Grid.Row="3">
                    <TreeView x:Name="RuleTree"
                              ItemsSource="{Binding Root.Children}"
                              Style="{StaticResource ModernTreeView}"
                              ItemContainerStyle="{StaticResource ModernTreeViewItem}"
                              SelectedItemChanged="RuleTree_SelectedItemChanged" />

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="20"
                                Visibility="{Binding HasRules, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="&#xE71C;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="هنوز شرطی اضافه نشده است"
                                   Style="{StaticResource SectionTitle}"
                                   FontSize="13"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0" />
                        <TextBlock Text="با دکمه «افزودن شرط» شروع کنید."
                                   Style="{StaticResource Caption}"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="0"
                      Grid.Column="1"
                      Style="{StaticResource VerticalSplitter}" />

        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource Card}" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="تنظیمات مورد انتخاب‌شده" Style="{StaticResource SectionTitle}" />

                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                        <TextBlock Text="یک گروه یا شرط را از درخت سمت راست انتخاب کنید تا تنظیمات آن را ویرایش کنید."
                                   Style="{StaticResource Caption}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding IsGroupSelected, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="نوع گروه" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding SelectedNode.GroupOperators}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedNode.SelectedGroupOperator, Mode=TwoWay}"
                                          Style="{StaticResource ModernComboBox}" />
                                <TextBlock Text="{Binding SelectedNode.GroupOperatorHint}"
                                           Style="{StaticResource Caption}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />
                                <TextBlock Text="{Binding SelectedNode.Title}"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0"
                                Visibility="{Binding IsConditionSelected, Converter={StaticResource BoolToVisibility}}">
                        <Border Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="فیلد" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding SelectedNode.FieldOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedNode.SelectedField, Mode=TwoWay}"
                                          Style="{StaticResource ModernComboBox}" />

                                <TextBlock Text="عملگر" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                <ComboBox ItemsSource="{Binding SelectedNode.OperatorOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedNode.SelectedOperator, Mode=TwoWay}"
                                          Style="{StaticResource ModernComboBox}" />

                                <StackPanel Visibility="{Binding SelectedNode.RequiresValue, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="مقدار" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                    <TextBox Text="{Binding SelectedNode.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding SelectedNode.ShowsSecondValue, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="مقدار دوم (پایان بازه)" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                                    <TextBox Text="{Binding SelectedNode.Value2, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBox}" />
                                </StackPanel>

                                <TextBlock Text="{Binding SelectedNode.ValueHint}"
                                           Style="{StaticResource Caption}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0" />

                                <TextBlock Text="{Binding SelectedNode.InputHint}"
                                           Style="{StaticResource Caption}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="پیش‌نمایش شرط"
                                           FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding SelectedNode.Title}"
                                           Foreground="{StaticResource AccentBrush}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" />
                    <TextBlock Text="تغییرات فقط پس از تأیید اعمال می‌شوند."
                               Style="{StaticResource Caption}"
                               Foreground="{StaticResource TextMutedBrush}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="تأیید و بازگشت"
                            Style="{StaticResource PrimaryButton}"
                            Width="150"
                            Click="Ok_Click"
                            IsDefault="True" />
                    <Button Content="انصراف"
                            Style="{StaticResource SecondaryButton}"
                            Width="110"
                            Margin="8,0,0,0"
                            Click="Cancel_Click"
                            IsCancel="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
