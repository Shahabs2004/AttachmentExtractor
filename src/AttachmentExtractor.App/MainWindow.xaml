<Window x:Class="AttachmentExtractor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AttachmentExtractor.App.ViewModels"
        Title="استخراج‌گر پیوست‌های Outlook"
        Width="1520"
        Height="940"
        MinWidth="1180"
        MinHeight="740"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="46"
                        Height="46"
                        CornerRadius="13"
                        Background="#26FFFFFF"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE723;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="23"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="استخراج‌گر پیوست‌های Outlook"
                               FontSize="19"
                               FontWeight="Bold"
                               Foreground="White" />
                    <TextBlock Text="جست‌وجو، فیلتر حرفه‌ای و ذخیره امن پیوست‌های ایمیل — با تقویم شمسی"
                               FontSize="11.5"
                               Foreground="{StaticResource HeaderMutedBrush}"
                               Margin="0,3,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="#1FFFFFFF"
                            CornerRadius="10"
                            Padding="12,7"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FCA5A5" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Fill" Value="#34D399" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <TextBlock FontSize="11.5"
                                       Foreground="White"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="اتصال برقرار نیست" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                                <Setter Property="Text" Value="متصل به Outlook" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource HeaderButton}"
                            Command="{Binding RefreshFoldersCommand}"
                            ToolTip="اتصال دوباره به Outlook و دریافت مجدد پوشه‌ها">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="13"
                                       Margin="0,0,7,0"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="بارگذاری پوشه‌ها" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="16,14,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="230" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="700" />
            </Grid.ColumnDefinitions>

            <!-- Folder sidebar -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="15"
                                       Foreground="{StaticResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0" />
                            <TextBlock Text="پوشه‌های Outlook" Style="{StaticResource SectionTitle}" />
                        </StackPanel>
                        <Border Style="{StaticResource Pill}" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <TextBlock Text="{Binding FolderSelectionSummary}"
                                       FontSize="11"
                                       Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <WrapPanel Grid.Row="1" Margin="0,10,0,4">
                        <Button Content="همه"
                                Style="{StaticResource SmallSecondaryButton}"
                                Command="{Binding SelectAllFoldersCommand}"
                                Margin="0,0,6,4" />
                        <Button Content="هیچ‌کدام"
                                Style="{StaticResource SmallSecondaryButton}"
                                Command="{Binding ClearFoldersSelectionCommand}"
                                Margin="0,0,6,4" />
                        <Button Content="صندوق ورودی"
                                Style="{StaticResource SmallSecondaryButton}"
                                Command="{Binding SelectInboxCommand}"
                                Margin="0,0,6,4" />
                    </WrapPanel>

                    <TreeView Grid.Row="2"
                              ItemsSource="{Binding Folders}"
                              Style="{StaticResource ModernTreeView}"
                              ItemContainerStyle="{StaticResource ModernTreeViewItem}"
                              Margin="0,6,0,0">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FolderNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <Grid ToolTip="{Binding FullPath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsThreeState="True"
                                              Style="{StaticResource ModernCheckBox}"
                                              Margin="0"
                                              VerticalAlignment="Center"
                                              Focusable="False" />

                                    <Path Grid.Column="1"
                                          Data="M 2,5 L 8,5 L 10,7 L 20,7 L 20,18 L 2,18 Z"
                                          Fill="{StaticResource AccentLightBrush}"
                                          Stroke="{StaticResource AccentBrush}"
                                          StrokeThickness="1"
                                          Width="15"
                                          Height="14"
                                          Stretch="Fill"
                                          Margin="7,0,6,0"
                                          VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                    </TreeView>

                    <TextBlock Grid.Row="3"
                               Text="با انتخاب هر پوشه، زیرپوشه‌های آن نیز انتخاب می‌شوند."
                               Style="{StaticResource Caption}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}" />

            <!-- Main area -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Filter card -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="16,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71C;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="فیلتر ایمیل‌ها" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <TextBlock Text="تاریخ‌ها را شمسی یا میلادی وارد کنید؛ مثال: 1404/08/11 یا 2025-11-02"
                                           Style="{StaticResource Caption}"
                                           Margin="0,4,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="{Binding FilterPanelToggleLabel}"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ToggleFilterPanelCommand}"
                                        Margin="0,0,6,0" />

                                <Button Content="لغو"
                                        Style="{StaticResource SmallDangerButton}"
                                        Command="{Binding CancelCommand}"
                                        Width="72"
                                        Margin="0,0,6,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                                <Button Content="پاک کردن فیلترها"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ClearQuickFiltersCommand}"
                                        Margin="0,0,6,0" />

                                <Button Content="فیلتر پیشرفته…"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding EditAdvancedFilterCommand}"
                                        Margin="0,0,8,0" />

                                <Button Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ScanCommand}"
                                        Width="156"
                                        ToolTip="اسکن ایمیل‌های پوشه‌های انتخاب‌شده (F5)">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE721;"
                                                   FontFamily="Segoe MDL2 Assets"
                                                   FontSize="13"
                                                   Margin="0,0,7,0"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="اسکن ایمیل‌ها" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <StackPanel Visibility="{Binding IsFilterPanelExpanded, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="پروفایل فیلتر"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />

                            <ComboBox Grid.Column="1"
                                      Width="185"
                                      ItemsSource="{Binding Profiles}"
                                      DisplayMemberPath="Name"
                                      SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                      Style="{StaticResource ModernComboBox}"
                                      ToolTip="پروفایل‌های ذخیره‌شده فیلتر"
                                      IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        Margin="8,0,0,0">
                                <Button Content="ذخیره"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding SaveProfileCommand}"
                                        Margin="0,0,5,0" />
                                <Button Content="حذف"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding DeleteProfileCommand}"
                                        Margin="0,0,5,0" />
                                <Button Content="ورود"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ImportProfileCommand}"
                                        Margin="0,0,5,0" />
                                <Button Content="خروجی"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ExportProfileCommand}" />
                            </StackPanel>

                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding AdvancedFilterSummary}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Button Content="پاک کردن فیلتر پیشرفته"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ClearAdvancedFilterCommand}" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,10,0,0">
                            <StackPanel Width="126" Margin="0,0,10,8">
                                <TextBlock Text="از تاریخ (شمسی)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="مثال: 1404/08/01 یا 2025-10-23" />
                            </StackPanel>

                            <StackPanel Width="126" Margin="0,0,10,8">
                                <TextBlock Text="تا تاریخ (شمسی)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="مثال: 1404/08/30 یا 2025-11-21" />
                            </StackPanel>

                            <StackPanel Width="152" Margin="0,0,10,8">
                                <TextBlock Text="فرستنده" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding Sender, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="بخشی از نام یا ایمیل فرستنده" />
                            </StackPanel>

                            <StackPanel Width="138" Margin="0,0,10,8">
                                <TextBlock Text="دامنه فرستنده" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding SenderDomain, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="مثال: company.com" />
                            </StackPanel>

                            <StackPanel Width="142" Margin="0,0,10,8">
                                <TextBlock Text="گیرنده (To/CC)" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding Recipient, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="بخشی از نام یا ایمیل گیرنده" />
                            </StackPanel>

                            <StackPanel Width="158" Margin="0,0,10,8">
                                <TextBlock Text="موضوع ایمیل" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="بخشی از متن موضوع" />
                            </StackPanel>

                            <StackPanel Width="122" Margin="0,0,10,8">
                                <TextBlock Text="پسوند پیوست" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding Extension, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="چند پسوند را با کاما جدا کنید: pdf, docx" />
                            </StackPanel>

                            <StackPanel Width="104" Margin="0,0,10,8">
                                <TextBlock Text="حداقل اندازه MB" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding MinSizeMb, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="مثال: 0.5" />
                            </StackPanel>

                            <StackPanel Width="104" Margin="0,0,10,8">
                                <TextBlock Text="حداکثر اندازه MB" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding MaxSizeMb, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="مثال: 10" />
                            </StackPanel>

                            <StackPanel Width="110" Margin="0,0,10,8">
                                <TextBlock Text="حداقل تعداد پیوست" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding MinAttachmentCount, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="مثال: 1" />
                            </StackPanel>

                            <StackPanel Width="118" Margin="0,0,10,8">
                                <TextBlock Text="اهمیت" Style="{StaticResource FieldLabel}" />
                                <ComboBox ItemsSource="{Binding ImportanceOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Importance, Mode=TwoWay}"
                                          Style="{StaticResource ModernComboBox}" />
                            </StackPanel>

                            <StackPanel Width="138" Margin="0,0,10,8">
                                <TextBlock Text="دسته‌بندی" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="مثال: مالی" />
                            </StackPanel>

                            <StackPanel Width="184" Margin="0,0,10,8">
                                <TextBlock Text="جست‌وجو در متن ایمیل" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding IncludeBody}"
                                         ToolTip="برای فعال‌سازی، گزینه «دریافت متن ایمیل» را تیک بزنید" />
                            </StackPanel>
                        </WrapPanel>

                        <WrapPanel Margin="0,2,0,0">
                            <TextBlock Text="بازه سریع:"
                                       FontSize="11.5"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,7,4" />
                            <Button Content="۷ روز اخیر"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SetLast7DaysCommand}"
                                    Margin="0,0,5,4" />
                            <Button Content="۳۰ روز اخیر"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SetLast30DaysCommand}"
                                    Margin="0,0,5,4" />
                            <Button Content="امسال"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SetCurrentYearCommand}"
                                    Margin="0,0,5,4" />
                            <Button Content="سال گذشته"
                                    Style="{StaticResource SmallSecondaryButton}"
                                    Command="{Binding SetPreviousYearCommand}"
                                    Margin="0,0,14,4" />

                            <CheckBox Content="فقط ایمیل‌های دارای پیوست"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsChecked="{Binding OnlyWithAttachments, Mode=TwoWay}"
                                      Margin="0,0,14,4" />
                            <CheckBox Content="فقط خوانده‌نشده‌ها"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsChecked="{Binding UnreadOnly, Mode=TwoWay}"
                                      Margin="0,0,14,4" />
                            <CheckBox Content="دریافت متن ایمیل (کندتر)"
                                      Style="{StaticResource ModernCheckBox}"
                                      IsChecked="{Binding IncludeBody, Mode=TwoWay}"
                                      ToolTip="برای جست‌وجو یا پیش‌نمایش متن ایمیل لازم است"
                                      Margin="0,0,0,4" />
                        </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Results card -->
                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE715;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="15"
                                               Foreground="{StaticResource AccentBrush}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                    <TextBlock Text="نتایج جست‌وجو" Style="{StaticResource SectionTitle}" />
                                </StackPanel>
                                <TextBlock Text="{Binding ResultSummary}"
                                           Style="{StaticResource Caption}"
                                           Margin="0,3,0,0" />
                                <TextBlock Text="{Binding SelectionSummary}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource AccentBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button Content="انتخاب همه"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding SelectAllMessagesCommand}"
                                        Margin="0,0,6,0" />
                                <Button Content="هیچ‌کدام"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ClearMessagesSelectionCommand}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="300" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="350" MinWidth="290" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <DataGrid ItemsSource="{Binding Messages}"
                                          SelectedItem="{Binding SelectedMessage, Mode=TwoWay}"
                                          Style="{StaticResource ModernDataGrid}"
                                          Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}}">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="46">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource ModernCheckBox}"
                                                              Margin="0"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="موضوع" Width="*" SortMemberPath="Subject">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Subject}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   FontSize="12.5" />
                                                        <TextBlock Text="{Binding AttachmentSummary}"
                                                                   Style="{StaticResource Caption}"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="فرستنده" Width="180" SortMemberPath="SenderDisplay">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Border Width="28"
                                                                Height="28"
                                                                CornerRadius="14"
                                                                Background="{StaticResource AccentSoftBrush}"
                                                                Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding SenderInitial}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center" />
                                                        </Border>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SenderName}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="132" />
                                                            <TextBlock Text="{Binding SenderEmail}"
                                                                       Style="{StaticResource Caption}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       MaxWidth="132"
                                                                       ToolTip="{Binding SenderEmail}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTemplateColumn Header="تاریخ دریافت" Width="120" SortMemberPath="ReceivedTime">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ReceivedJalali}"
                                                               ToolTip="{Binding ReceivedGregorian}"
                                                               VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="پوشه" Width="115" Binding="{Binding FolderName}">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="ToolTip" Value="{Binding FolderPath}" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>

                                        <DataGridTemplateColumn Header="پیوست" Width="88" SortMemberPath="AttachmentCount">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource Pill}" HorizontalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="&#xE723;"
                                                                       FontFamily="Segoe MDL2 Assets"
                                                                       FontSize="10.5"
                                                                       Foreground="{StaticResource AccentBrush}"
                                                                       Margin="0,0,4,0"
                                                                       VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding AttachmentCount}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AccentBrush}" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>

                                        <DataGridTextColumn Header="حجم" Width="82" Binding="{Binding SizeText}" SortMemberPath="SizeBytes">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>

                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                </DataGrid>

                                <StackPanel VerticalAlignment="Center"
                                            HorizontalAlignment="Center"
                                            Visibility="{Binding HasMessages, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                    <TextBlock Text="&#xE715;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="34"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" />
                                    <TextBlock Text="نتیجه‌ای برای نمایش نیست"
                                               Style="{StaticResource SectionTitle}"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               Margin="0,10,0,0" />
                                    <TextBlock Text="پوشه‌ها را انتخاب کنید، فیلترها را تنظیم کنید و «اسکن ایمیل‌ها» را بزنید."
                                               Style="{StaticResource Caption}"
                                               HorizontalAlignment="Center"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <GridSplitter Grid.Column="1" Style="{StaticResource VerticalSplitter}" />

                            <!-- Details / logs -->
                            <Border Grid.Column="2"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <StackPanel Visibility="{Binding HasSelectedMessage, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="{Binding SelectedMessage.Subject}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="58" />
                                        <TextBlock Text="{Binding SelectedMessage.SenderDisplay}"
                                                   Style="{StaticResource Caption}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0" />

                                        <WrapPanel Margin="0,6,0,0">
                                            <TextBlock Text="{Binding SelectedMessage.ReceivedJalali}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text=" • "
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding SelectedMessage.FolderName}"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="150"
                                                       ToolTip="{Binding SelectedMessage.FolderPath}" />
                                            <TextBlock Text=" • "
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding SelectedMessage.ImportanceLabel}"
                                                       FontSize="11"
                                                       Foreground="{Binding SelectedMessage.ImportanceValue, Converter={StaticResource ImportanceToBrush}}" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding HasSelectedMessage, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
                                        <TextBlock Text="جزئیات ایمیل"
                                                   Style="{StaticResource SectionTitle}"
                                                   FontSize="13" />
                                        <TextBlock Text="برای مشاهده پیوست‌ها و متن ایمیل، یک ردیف از نتایج را انتخاب کنید."
                                                   Style="{StaticResource Caption}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>

                                    <TabControl Grid.Row="1"
                                                Margin="0,10,0,0"
                                                Style="{StaticResource ModernTabControl}">
                                        <TabItem Header="پیوست‌ها" Style="{StaticResource ModernTabItem}">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid>
                                                    <TextBlock Text="{Binding SelectedMessage.SelectedAttachmentSummary}"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <StackPanel Orientation="Horizontal"
                                                                HorizontalAlignment="Left">
                                                        <Button Content="همه"
                                                                Style="{StaticResource SmallSecondaryButton}"
                                                                Command="{Binding SelectAllAttachmentsCommand}"
                                                                Margin="0,0,5,0" />
                                                        <Button Content="هیچ‌کدام"
                                                                Style="{StaticResource SmallSecondaryButton}"
                                                                Command="{Binding ClearAttachmentsSelectionCommand}" />
                                                    </StackPanel>
                                                </Grid>

                                                <ScrollViewer Grid.Row="1"
                                                              Margin="0,6,0,0"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding SelectedMessage.Attachments}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource BorderBrush}"
                                                                        BorderThickness="0,0,0,1"
                                                                        Padding="0,7">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                                  Style="{StaticResource ModernCheckBox}"
                                                                                  Margin="0"
                                                                                  VerticalAlignment="Center" />

                                                                        <Border Grid.Column="1"
                                                                                Background="{Binding ExtensionBadge, Converter={StaticResource ExtensionToBrush}}"
                                                                                CornerRadius="6"
                                                                                Padding="6,3"
                                                                                MinWidth="42"
                                                                                Margin="8,0,0,0"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ExtensionBadge}"
                                                                                       FontSize="9.5"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="White"
                                                                                       HorizontalAlignment="Center" />
                                                                        </Border>

                                                                        <StackPanel Grid.Column="2"
                                                                                    Margin="8,0,0,0"
                                                                                    VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding FileName}"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTip="{Binding FileName}" />
                                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                                <TextBlock Text="{Binding SizeText}"
                                                                                           Style="{StaticResource Caption}" />
                                                                                <TextBlock Text=" • "
                                                                                           Style="{StaticResource Caption}" />
                                                                                <TextBlock Text="{Binding TypeLabel}"
                                                                                           Style="{StaticResource Caption}" />
                                                                            </StackPanel>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <TextBlock Grid.Row="1"
                                                           Text="این ایمیل پیوستی ندارد یا هنوز ایمیلی انتخاب نشده است."
                                                           Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           MaxWidth="230"
                                                           Visibility="{Binding HasSelectedMessageAttachments, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                            </Grid>
                                        </TabItem>

                                        <TabItem Header="متن ایمیل" Style="{StaticResource ModernTabItem}">
                                            <Grid Margin="0,8,0,0">
                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                    <TextBlock Text="{Binding SelectedMessage.BodyPreview}"
                                                               TextWrapping="Wrap"
                                                               LineHeight="21"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                </ScrollViewer>

                                                <TextBlock Text="ایمیلی انتخاب نشده است."
                                                           Style="{StaticResource Caption}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Visibility="{Binding HasSelectedMessage, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
                                            </Grid>
                                        </TabItem>

                                        <TabItem Header="گزارش" Style="{StaticResource ModernTabItem}">
                                            <Grid Margin="0,8,0,0">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>

                                                <Grid>
                                                    <TextBlock Text="گزارش عملیات"
                                                               FontSize="11.5"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Button Content="پاک کردن گزارش"
                                                            Style="{StaticResource SmallSecondaryButton}"
                                                            Command="{Binding ClearLogsCommand}"
                                                            HorizontalAlignment="Left" />
                                                </Grid>

                                                <ScrollViewer Grid.Row="1"
                                                              Margin="0,6,0,0"
                                                              VerticalScrollBarVisibility="Auto">
                                                    <ItemsControl ItemsSource="{Binding Logs}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Text="{Binding TimeText}"
                                                                               Style="{StaticResource Caption}"
                                                                               Width="48"
                                                                               VerticalAlignment="Top" />

                                                                    <Border Grid.Column="1"
                                                                            Style="{StaticResource Pill}"
                                                                            Background="{StaticResource SurfaceBrush}"
                                                                            Margin="0,0,6,0"
                                                                            VerticalAlignment="Top">
                                                                        <TextBlock Text="{Binding LevelText}"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" />
                                                                    </Border>

                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding Message}"
                                                                               TextWrapping="Wrap"
                                                                               FontSize="11.5"
                                                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToBrush}}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </Grid>
                                        </TabItem>
                                    </TabControl>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Export card -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="238" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="15"
                                           Foreground="{StaticResource AccentBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="تنظیمات خروجی" Style="{StaticResource SectionTitle}" />
                                <Button Content="{Binding ExportSettingsToggleLabel}"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding ToggleExportSettingsCommand}"
                                        VerticalAlignment="Center"
                                        Margin="12,0,0,0" />
                            </StackPanel>

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="330" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="مسیر مقصد"
                                           Style="{StaticResource FieldLabel}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <TextBox Grid.Column="1"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding DestinationRoot, UpdateSourceTrigger=PropertyChanged}"
                                         FlowDirection="LeftToRight"
                                         ToolTip="{Binding DestinationRoot}" />
                                <Button Grid.Column="2"
                                        Content="انتخاب…"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding BrowseDestinationCommand}"
                                        Height="34"
                                        Margin="6,0,0,0" />
                            </Grid>

                            <StackPanel Visibility="{Binding IsExportSettingsExpanded, Converter={StaticResource BoolToVisibility}}">
                            <WrapPanel Margin="0,10,0,0">
                                <StackPanel Width="150" Margin="0,0,10,8">
                                    <TextBlock Text="ساختار پوشه‌ها" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding StructureOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedStructure, Mode=TwoWay}"
                                              Style="{StaticResource ModernComboBox}" />
                                </StackPanel>

                                <StackPanel Width="158" Margin="0,0,10,8">
                                    <TextBlock Text="رفتار فایل تکراری" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding CollisionOptions}"
                                              DisplayMemberPath="Label"
                                              SelectedItem="{Binding SelectedCollision, Mode=TwoWay}"
                                              Style="{StaticResource ModernComboBox}" />
                                </StackPanel>

                                <StackPanel Width="212" Margin="0,0,10,8">
                                    <TextBlock Text="قالب پوشه سفارشی" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding CustomFolderTemplate, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsCustomStructure}"
                                             FlowDirection="LeftToRight"
                                             ToolTip="مثال: {SenderEmail}\{JalaliDate:yyyy-MM}" />
                                </StackPanel>

                                <StackPanel Width="212" Margin="0,0,10,8">
                                    <TextBlock Text="قالب نام فایل" Style="{StaticResource FieldLabel}" />
                                    <TextBox Style="{StaticResource ModernTextBox}"
                                             Text="{Binding FileNameTemplate, UpdateSourceTrigger=PropertyChanged}"
                                             FlowDirection="LeftToRight"
                                             ToolTip="مثال: {JalaliDate:yyyyMMdd}-{BaseName}" />
                                </StackPanel>
                            </WrapPanel>

                            <WrapPanel Margin="0,0,0,2">
                                <CheckBox Content="ساخت گزارش CSV و JSON"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="{Binding CreateManifest, Mode=TwoWay}" />
                                <CheckBox Content="حفظ تاریخ ایمیل روی فایل"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="{Binding PreserveTimestamps, Mode=TwoWay}" />
                                <CheckBox Content="باز کردن پوشه پس از ذخیره"
                                          Style="{StaticResource ModernCheckBox}"
                                          IsChecked="{Binding OpenFolderAfterExport, Mode=TwoWay}" />
                            </WrapPanel>

                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Text="توکن‌های مجاز:"
                                           Style="{StaticResource Caption}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <TextBlock Text="{}{OriginalName} {SenderEmail} {Subject} {JalaliDate:yyyy-MM} {Folder} {Index}"
                                           Style="{StaticResource Caption}"
                                           FlowDirection="LeftToRight"
                                           VerticalAlignment="Center" />
                            </WrapPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Grid.Column="1"
                                Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="10"
                                Padding="12"
                                Margin="12,0,0,0">
                            <StackPanel>
                                <TextBlock Text="خروجی پیوست‌ها"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentDarkBrush}" />

                                <TextBlock Text="فقط ایمیل‌ها و پیوست‌های تیک‌خورده ذخیره می‌شوند."
                                           Style="{StaticResource Caption}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,8" />

                                <Button Content="ذخیره پیوست‌های انتخاب‌شده"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding ExportCommand}"
                                        Height="40"
                                        ToolTip="ذخیره پیوست‌ها (Ctrl+E)" />

                                <ProgressBar Style="{StaticResource ModernProgressBar}"
                                             Minimum="0"
                                             Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                             Value="{Binding ProgressValue, Mode=OneWay}"
                                             IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                             Margin="0,10,0,0"
                                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                                <TextBlock Text="{Binding BusyText}"
                                           Style="{StaticResource Caption}"
                                           TextWrapping="Wrap"
                                           MaxHeight="32"
                                           Margin="0,5,0,0"
                                           Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                                <Button Content="لغو عملیات"
                                        Style="{StaticResource SmallDangerButton}"
                                        Command="{Binding CancelCommand}"
                                        Margin="0,6,0,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

                                <Button Content="باز کردن پوشه مقصد"
                                        Style="{StaticResource SmallSecondaryButton}"
                                        Command="{Binding OpenDestinationCommand}"
                                        Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Version}"
                               Style="{StaticResource Caption}" />
                    <TextBlock Text=" • "
                               Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding FolderSelectionSummary}"
                               Style="{StaticResource Caption}" />
                    <TextBlock Text=" • "
                               Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding ResultSummary}"
                               Style="{StaticResource Caption}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="360" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <ProgressBar Style="{StaticResource ModernProgressBar}"
                                 Width="110"
                                 Height="5"
                                 Minimum="0"
                                 Maximum="{Binding ProgressMaximum, Mode=OneWay}"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                                 Margin="0,0,10,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11.5"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="520"
                               VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="توسعه: شهاب صادقی"
                               Style="{StaticResource Caption}" />
                    <TextBlock Text=" • "
                               Style="{StaticResource Caption}" />
                    <TextBlock Text="F5 اسکن • Ctrl+E خروجی • Esc لغو"
                               Style="{StaticResource Caption}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
